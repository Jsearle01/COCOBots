# Local-only reference material — present on disk, never pushed (Jay, 2026-07-31)
# NOTE: /reference/** (not /reference/) so git still descends and the MANIFEST
# re-include below can fire. Verified with `git check-ignore -v`.
/reference/**
!/reference/pet/
!/reference/pet/MANIFEST.md

/docs/ground-truth/*
!/docs/ground-truth/MANIFEST.md

# Build products
/build/
/dist/
*.bin.tmp
*.lst
*.dsk

# Tooling scratch — MAME writes cfg/ and snap/ into the working directory unless
# -cfg_directory / -snapshot_directory point elsewhere (A2); Python caches tools/
/cfg/
/snap/
__pycache__/

# Glyph editor crash buffer (C6). The authored font and its versioned snapshots
# under /assets/authored/ ARE tracked — that is the protection. This one file is
# a rolling autosave, rewritten every few seconds while drawing.
/assets/authored/autosave/

# Packaging artifacts — must never be committed
/*.zip
PLACEMENT.md
